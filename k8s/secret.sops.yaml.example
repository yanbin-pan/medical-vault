# Template for k8s/secret.sops.yaml.
#
# This file is NOT deployed. Copy it, fill in the real values, encrypt it, and
# commit the encrypted result — Flux decrypts it with the cluster's age key.
#
#   cp k8s/secret.sops.yaml.example k8s/secret.sops.yaml
#   $EDITOR k8s/secret.sops.yaml
#   sops --encrypt --in-place k8s/secret.sops.yaml
#   grep -c 'ENC\[' k8s/secret.sops.yaml     # must be > 0 before committing
#
# The age recipient comes from .sops.yaml at the root of the home-cluster
# repository; that public key is safe to copy here. `stringData` is inside
# home-cluster's `encrypted_regex`, so metadata stays readable and the diff
# stays reviewable.
apiVersion: v1
kind: Secret
metadata:
  name: medical-vault
  namespace: medical-vault
type: Opaque
stringData:
  # Anthropic API key used to read uploaded documents. Without it the
  # application still serves everything already stored; only new uploads fail.
  anthropic-api-key: sk-ant-REPLACE-ME

  # Must match POSTGRES_PASSWORD wiring in postgres.yaml.
  postgres-password: REPLACE-WITH-A-LONG-RANDOM-STRING

  # The same password again, in the URL the API connects with. Kept whole rather
  # than assembled from parts so that pointing the application at a database
  # somewhere else is a one-line change.
  database-url: postgresql+psycopg://medvault:REPLACE-WITH-A-LONG-RANDOM-STRING@postgres:5432/medvault
