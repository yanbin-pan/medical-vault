# Template for k8s/secret.sops.yaml.
#
# This file is NOT deployed. Copy it, fill in the real value, encrypt it, and
# commit the encrypted result — Flux decrypts it with the cluster's age key.
#
#   cp k8s/secret.sops.yaml.example k8s/secret.sops.yaml
#   $EDITOR k8s/secret.sops.yaml
#   sops --encrypt --in-place k8s/secret.sops.yaml
#   grep -c 'ENC\[' k8s/secret.sops.yaml     # must be > 0 before committing
#
# The age recipient and the encrypted_regex come from .sops.yaml at the root of
# this repository. `stringData` is what gets encrypted, so metadata stays
# readable and the diff stays reviewable.
apiVersion: v1
kind: Secret
metadata:
  name: medical-vault
  namespace: medical-vault
type: Opaque
stringData:
  # The only secret this application needs. It reads uploaded documents; without
  # it everything already stored still serves normally and only new uploads fail.
  #
  # There is no database password here: the projection is SQLite in an emptyDir,
  # rebuilt from the vault on every start, so there is nothing to authenticate to.
  anthropic-api-key: sk-ant-REPLACE-ME
